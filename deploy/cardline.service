# Serviço de usuário do systemd: o cardline liga junto com o PC e volta sozinho se cair.
#   cp deploy/cardline.service ~/.config/systemd/user/ && systemctl --user enable --now cardline
# (com `loginctl enable-linger`, liga no boot mesmo sem ninguém entrar na sessão)
[Unit]
Description=cardline: página, API e pipelines na porta 8000

[Service]
WorkingDirectory=%h/cardline
ExecStart=%h/cardline/.venv/bin/cardline serve --host 0.0.0.0 --port 8000
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/cardline/data/servidor.log
StandardError=inherit

[Install]
WantedBy=default.target
